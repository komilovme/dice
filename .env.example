# ============================================================================
# Telegram Dice Game Bot - Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ----- Application -----
APP_ENV=production              # production | staging | development
DEBUG=false
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
TZ=UTC

# ----- Telegram -----
BOT_TOKEN=123456:replace-with-your-bot-token
# Comma separated Telegram user IDs that have admin access.
ADMIN_IDS=11111111,22222222
# Optional channel/group id where the bot logs admin actions / anti-cheat alerts.
LOG_CHANNEL_ID=

# Webhook mode (optional). If WEBHOOK_URL is empty the bot uses long polling.
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=change-me-to-a-long-random-string
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# ----- PostgreSQL -----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=dicebot
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=dicebot
# Connection pool tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ----- Game / Economy tuning -----
STARTING_BALANCE=1000
DAILY_REWARD=250
WEEKLY_REWARD=1500
REFERRAL_REWARD=500
MIN_BET=10
MAX_BET=1000000
# House edge (fraction) skimmed from each settled battle pot for sinks.
HOUSE_EDGE=0.02

# ----- Anti-cheat / rate limiting -----
RATE_LIMIT_PER_SECOND=3
BATTLE_COOLDOWN_SECONDS=3
MAX_DAILY_BATTLES=2000

# ----- Runtime -----
# Run the background scheduler in this process. In multi-replica deployments set
# this to true on exactly ONE replica (or a dedicated worker) and false elsewhere.
RUN_SCHEDULER=true
