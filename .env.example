# ============================================================================
# Telegram Dice Game Bot - Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ----- Application -----
APP_ENV=production              # production | staging | development
DEBUG=false
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
TZ=UTC

# ----- Telegram -----
BOT_TOKEN=8160857736:AAEmv_2uhpyfS-cSHv6y44HhIx8b1oEctw4
# Comma separated Telegram user IDs that have admin access.
ADMIN_IDS=7053349365
# Optional channel/group id where the bot logs admin actions / anti-cheat alerts.
LOG_CHANNEL_ID=2639765877

# Webhook mode (optional). If WEBHOOK_URL is empty the bot uses long polling.
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=AAEmv_2uhpyfS-cSHv6y44HhIx8b1oEctw4
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

POSTGRES_HOST=aws-1-ap-northeast-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres.kxsgepcjbkzpurjxdrcg
POSTGRES_PASSWORD=Komilov.1222
POSTGRES_DB=postgres

# Connection pool tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ----- Game / Economy tuning -----
STARTING_BALANCE=1000
DAILY_REWARD=250
WEEKLY_REWARD=1500
REFERRAL_REWARD=500
MIN_BET=10
MAX_BET=1000000
# House edge (fraction) skimmed from each settled battle pot for sinks.
HOUSE_EDGE=0.02

# ----- Anti-cheat / rate limiting -----
RATE_LIMIT_PER_SECOND=3
BATTLE_COOLDOWN_SECONDS=3
MAX_DAILY_BATTLES=2000

# ----- Runtime -----
# Run the background scheduler in this process. In multi-replica deployments set
# this to true on exactly ONE replica (or a dedicated worker) and false elsewhere.
RUN_SCHEDULER=true


# ============================================================================
# Railway deployment (railway.com)
# ----------------------------------------------------------------------------
# On Railway you do NOT set POSTGRES_*/REDIS_*/WEBHOOK_URL/PORT yourself.
# Railway injects them. You only need to set BOT_TOKEN and ADMIN_IDS, plus
# reference the database/redis services. In the bot service "Variables" tab add:
#
#   BOT_TOKEN  = <your bot token>
#   ADMIN_IDS  = <your telegram id>
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}      # reference your Postgres service
#   REDIS_URL    = ${{Redis.REDIS_URL}}            # reference your Redis service
#
# Railway automatically provides PORT and RAILWAY_PUBLIC_DOMAIN once you click
# "Generate Domain". The app reads those and runs in webhook mode automatically.
# Set FORCE_POLLING=true if you prefer long-polling instead of webhooks.
#
# FORCE_POLLING=false
# ============================================================================
